{
  "name": "sage-assistant",
  "productName": "Sage",
  "version": "0.1.0",
  "description": "Locally controlled Sage desktop host",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.cjs",
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.renderer.config.ts",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check desktop scripts/install-electron.mjs *.ts *.json *.mjs",
    "postinstall": "node scripts/install-electron.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "45.0.0",
    "eslint": "10.13.0",
    "typescript-eslint": "8.72.0",
    "prettier": "3.9.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
