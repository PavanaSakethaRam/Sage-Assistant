{
  "name": "sage-assistant",
  "productName": "Sage",
  "version": "0.1.0",
  "description": "Locally controlled Sage desktop host",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.cjs",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.renderer.config.ts",
    "test": "npm run test:unit",
    "test:unit": "vitest run --maxWorkers=1",
    "test:coverage": "vitest run --coverage --maxWorkers=1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check desktop \"extension/**/*.{ts,json,md}\" e2e \"scripts/*.{mjs,ts}\" *.ts *.json *.mjs",
    "postinstall": "node scripts/install-electron.mjs",
    "test:e2e": "node e2e/build.ts && playwright test",
    "verify": "node scripts/verify.mjs",
    "verify:deterministic": "node scripts/verify.mjs --deterministic",
    "check:package": "node scripts/check_package.ts",
    "smoke:package": "node scripts/smoke_package.mjs",
    "build:extension": "vite build --config vite.extension.config.ts",
    "typecheck:extension": "tsc --noEmit -p extension/tsconfig.json",
    "test:extension": "node scripts/test-vscode.ts",
    "package:extension": "npm run build:extension && cd extension && vsce package --no-dependencies --out ../.cache/sage-editor-bridge.vsix && cd .. && node scripts/check_extension.mjs .cache/sage-editor-bridge.vsix",
    "test:native-coverage": "node scripts/build-root-probe.ts --test-coverage"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.140.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "electron": "45.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-security": "4.2.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0"
  },
  "overrides": {
    "@vscode/vsce@4.0.0": {
      "@azure/identity@4.14.0": {
        "@azure/msal-node": "7.1.1"
      }
    }
  }
}
